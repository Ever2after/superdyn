# ---- Python, editors, OS ----
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
*.log
nohup.out
*.pid

# ---- Secrets and local environments ----
.env
**/.auth/
.venv*/
**/.venv*/

# ---- motion_audit (real split): models, raw videos, caches ----
motion_audit/vendor/
motion_audit/checkpoints/
motion_audit/cache/
motion_audit/videos/
motion_audit/metadata/
motion_audit/results/
motion_audit/*.tar
motion_audit/sample_manifest*.json
motion_audit/download_manifest.json
# Per-video evidence, marked media, model predictions and geometry caches
# (the released videos and QA annotations live in the Hugging Face dataset).
motion_audit/outputs/**/cases/
motion_audit/outputs/**/media/
motion_audit/outputs/**/predictions/
motion_audit/outputs/**/geometry/
motion_audit/outputs/**/workers/
motion_audit/outputs/**/source/
