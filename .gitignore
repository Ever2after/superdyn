motion_audit/outputs/temporal_geometry_fullscope/output_cleanup_scan.json
motion_audit/outputs/**/raw/
motion_audit/outputs/**/qa_visual_filter_pilot100/
# Large intermediate tables (>5 MB); the released QA set is qa/final/ and the HF dataset.
motion_audit/outputs/temporal_geometry_fullscope/qa/selected_records.json
motion_audit/outputs/temporal_geometry_fullscope/qa/qa_generated.json
motion_audit/outputs/temporal_geometry_fullscope/qa/qa.json
motion_audit/outputs/temporal_geometry_fullscope/qa/qa.jsonl
motion_audit/outputs/temporal_geometry_fullscope/qa/qa_visual_filter_fullscope/selection.json
motion_audit/outputs/temporal_vlm_eval_fullscope/inputs.json

